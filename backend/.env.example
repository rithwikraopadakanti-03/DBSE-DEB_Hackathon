# ─────────────────────────────────────────────────────────────
#  Campus Complaint System – Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (required)
# Get yours from: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_complaints?retryWrites=true&w=majority

# JWT secret key (required) – use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-secret

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# JWT token expiry in seconds (default: 86400 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRES=86400
